# Copy to .env and fill in. Never commit .env.

# MCP backend (Google Apigee MCP sample)
MCP_BASE_URL=https://your-apigee-host.example.com
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_MODE=
MCP_CACHE_TTL=300
BASE_PATH=
PORT=8080

# Optional SIEM connectors (delivery is stubbed in this demo)
CHRONICLE_ENDPOINT=
SPLUNK_HEC_ENDPOINT=
SPLUNK_HEC_TOKEN=
ELASTIC_ENDPOINT=
